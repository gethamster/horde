                },
                "attempts": {
                  "default": 1,
                  "description": "Maximum number of attempts, from 1 through 20.",
                  "format": "uint32",
                  "maximum": 20,
                  "minimum": 1,
                  "type": "integer"
                },
                "command": {
                  "default": [],
                  "description": "Command argv for a command step, not a shell string.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "environment": {
                  "additionalProperties": false,
                  "default": null,
                  "description": "Required when kind is environment; describes the disposable app and its test.",
                  "properties": {
                    "allow_external_resources": {
                      "default": false,
                      "type": "boolean"
                    },
                    "compose_file": {
                      "default": "compose.yaml",
                      "type": "string"
                    },
                    "cpus": {
                      "default": 2.0,
                      "exclusiveMinimum": 0,
                      "format": "double",
                      "type": "number"
                    },
                    "docker_context": {
                      "default": null,
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "env_file": {
                      "default": ".env",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "memory_mb": {
                      "default": 2048,
                      "format": "uint64",
                      "minimum": 64,
                      "type": "integer"
                    },
                    "readiness_seconds": {
                      "default": 60,
                      "description": "Positive readiness deadline, no greater than timeout_seconds.",
                      "format": "uint64",
                      "maximum": 86400,
                      "minimum": 1,
                      "type": "integer"
                    },
                    "ready_service": {
                      "default": null,
                      "type": [
                        "string",
                        "null"
                      ]
