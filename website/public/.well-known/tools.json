                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "start": {
                      "default": [],
                      "description": "Start command argv, required for the process runner.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "test": {
                      "description": "Test command argv; required for both process and Compose runners.",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    },
                    "timeout_seconds": {
                      "default": 1800,
                      "format": "uint64",
                      "maximum": 86400,
                      "minimum": 1,
                      "type": "integer"
