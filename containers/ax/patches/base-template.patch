+package substrate
+
+import (
+	"context"
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+	"testing"
+)
+
+type templateControl struct {
+	ateapipb.ControlClient
+	base      *ateapipb.ActorTemplate
+	existing  *ateapipb.ActorTemplate
+	created   *ateapipb.ActorTemplate
+	baseError error
+	baseReads int
+}
+
+func (c *templateControl) GetActorTemplate(_ context.Context, req *ateapipb.GetActorTemplateRequest, _ ...grpc.CallOption) (*ateapipb.ActorTemplate, error) {
+	if req.ActorTemplate.Name == "configured-base" {
+		c.baseReads++
+		if c.baseError != nil {
+			return nil, c.baseError
+		}
+		if c.base != nil {
+			return c.base, nil
+		}
+	} else if c.existing != nil {
+		return c.existing, nil
+	}
+	return nil, status.Error(codes.NotFound, "missing template")
+}
+func (c *templateControl) CreateActorTemplate(_ context.Context, req *ateapipb.CreateActorTemplateRequest, _ ...grpc.CallOption) (*ateapipb.ActorTemplate, error) {
+	c.created = req.ActorTemplate
+	return c.created, nil
+}
+func createDerived(control *templateControl) (*ateapipb.ActorTemplate, error) {
+	client := &Client{control: control}
+	return client.EnsureActorTemplateWithImage(context.Background(), "base-space", "configured-base", "task-space", "task-derived", "runner@sha256:abc", map[string]string{"AX_TASK_YAML": "public-task-spec"})
+}
+func TestDerivedTemplateInheritsGuestSecurityContext(t *testing.T) {
+	security := &ateapipb.SecurityContext{Capabilities: &ateapipb.Capabilities{Add: []string{"SYS_ADMIN", "NET_ADMIN"}, Drop: []string{"ALL"}}}
+	control := &templateControl{base: &ateapipb.ActorTemplate{
+		Containers: []*ateapipb.Container{{Name: "sidecar", SecurityContext: &ateapipb.SecurityContext{Capabilities: &ateapipb.Capabilities{Add: []string{"SYS_PTRACE"}}}}, {Name: "guest", Image: "base-image", Command: []string{"base-command"}, Env: []*ateapipb.EnvVar{{Name: "BASE_SECRET", Value: "must-not-inherit"}}, SecurityContext: security}},
+		Volumes:    []*ateapipb.Volume{{Name: "base-volume"}},
+	}}
+	before := proto.Clone(control.base)
+	got, err := createDerived(control)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !proto.Equal(got.Containers[0].SecurityContext, security) {
+		t.Fatalf("guest security context=%v, want %v", got.Containers[0].SecurityContext, security)
+	}
+	expected := BuildActorTemplate("task-space", "task-derived", "runner@sha256:abc", map[string]string{"AX_TASK_YAML": "public-task-spec"}, nil, "")
+	expected.Containers[0].SecurityContext = proto.Clone(security).(*ateapipb.SecurityContext)
+	if !proto.Equal(got, expected) {
+		t.Fatal("derived template changed image, environment, workspace, or snapshot defaults")
+	}
+	got.Containers[0].SecurityContext.Capabilities.Add[0] = "CHOWN"
+	if !proto.Equal(control.base, before) {
+		t.Fatal("derived security context aliases the base template")
+	}
+}
+func TestDerivedTemplateWithoutSecurityContextPreservesDefaults(t *testing.T) {
+	for _, base := range []*ateapipb.ActorTemplate{nil, {}, {Containers: []*ateapipb.Container{{Name: "guest"}}}, {Containers: []*ateapipb.Container{{Name: "sidecar", SecurityContext: &ateapipb.SecurityContext{Capabilities: &ateapipb.Capabilities{Add: []string{"SYS_ADMIN"}}}}}}} {
+		control := &templateControl{base: base}
+		got, err := createDerived(control)
+		if err != nil {
+			t.Fatal(err)
+		}
+		expected := BuildActorTemplate("task-space", "task-derived", "runner@sha256:abc", map[string]string{"AX_TASK_YAML": "public-task-spec"}, nil, "")
+		if !proto.Equal(got, expected) {
+			t.Fatal("default template behavior changed")
+		}
+	}
+}
+func TestExistingDerivedTemplateIsNotReconfigured(t *testing.T) {
+	existing := &ateapipb.ActorTemplate{Metadata: &ateapipb.ResourceMetadata{Name: "task-derived"}}
+	control := &templateControl{existing: existing}
+	got, err := createDerived(control)
+	if err != nil || got != existing || control.created != nil || control.baseReads != 0 {
+		t.Fatalf("existing immutable template was reconfigured: result=%v error=%v", got, err)
+	}
+}
+func TestBaseTemplateLookupFailureDoesNotSilentlyDiscardSecurityContext(t *testing.T) {
+	control := &templateControl{baseError: status.Error(codes.PermissionDenied, "denied")}
+	_, err := createDerived(control)
+	if err == nil {
+		t.Fatal("base lookup failure silently discarded requested security context")
+	}
+	if control.created != nil {
+		t.Fatal("created a fallback template after failed base lookup")
+	}
+}
+
+func TestDerivedTemplateInheritsGVisorSandboxConfig(t *testing.T) {
+	config := &ateapipb.SandboxConfig{SandboxClass: ateapipb.SandboxClass_SANDBOX_CLASS_GVISOR, ConfigName: "horde-dind-v1"}
+	control := &templateControl{base: &ateapipb.ActorTemplate{SandboxConfig: config}}
+	before := proto.Clone(control.base)
+	got, err := createDerived(control)
+	if err != nil {
+		t.Fatal(err)
+	}
+	expected := BuildActorTemplate("task-space", "task-derived", "runner@sha256:abc", map[string]string{"AX_TASK_YAML": "public-task-spec"}, nil, "")
+	expected.SandboxConfig = proto.Clone(config).(*ateapipb.SandboxConfig)
+	if !proto.Equal(got, expected) {
+		t.Fatalf("sandbox config=%v; expected selected gVisor config with other defaults unchanged", got.SandboxConfig)
+	}
+	got.SandboxConfig.ConfigName = "changed-derived-config"
+	if !proto.Equal(control.base, before) {
+		t.Fatal("derived sandbox config aliases the base template")
+	}
+}
+
+func TestDerivedTemplateRejectsNonGVisorSandboxConfig(t *testing.T) {
+	for _, class := range []ateapipb.SandboxClass{ateapipb.SandboxClass_SANDBOX_CLASS_UNSPECIFIED, ateapipb.SandboxClass_SANDBOX_CLASS_MICROVM} {
+		t.Run(class.String(), func(t *testing.T) {
+			control := &templateControl{base: &ateapipb.ActorTemplate{SandboxConfig: &ateapipb.SandboxConfig{SandboxClass: class, ConfigName: "unsupported"}}}
+			_, err := createDerived(control)
+			if err == nil {
+				t.Fatal("accepted a non-gVisor base sandbox config")
+			}
+			if control.created != nil {
+				t.Fatal("created a template with an unsupported sandbox class")
+			}
+		})
+	}
+}
