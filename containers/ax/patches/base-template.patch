+func TestTaskReconciler_CustomTemplateFailureDoesNotLaunchFallback(t *testing.T) {
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lis.Close()
+	mockSrv := &mockControlServer{templateError: status.Error(codes.PermissionDenied, "template creation denied")}
+	server := grpc.NewServer()
+	ateapipb.RegisterControlServer(server, mockSrv)
+	go server.Serve(lis)
+	defer server.Stop()
+	client, err := substrate.NewClient(lis.Addr().String(), grpc.WithTransportCredentials(insecure.NewCredentials()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	reconciler := controller.NewTaskReconciler(client, "configured-base", "base-space")
+	reconciler.SecretResolver = noSecrets
+	reconciler.WorkspaceReadyTimeout = time.Millisecond
+	task := &v1alpha1.Task{Metadata: &v1alpha1.ObjectMeta{Name: "must-not-fallback", Atespace: "task-space"}, Spec: &v1alpha1.TaskSpec{Image: "selected-image"}}
+	got, err := reconciler.Reconcile(context.Background(), task, nil)
+	if err == nil {
+		t.Fatal("custom template failure silently launched fallback")
+	}
+	if len(mockSrv.createdActors) != 0 || len(mockSrv.resumedActors) != 0 {
+		t.Fatal("created or resumed an actor after template failure")
+	}
+	if got == nil || got.Status.Phase != "Failed" {
+		t.Fatalf("task failure not retained: %v", got)
+	}
+	for _, condition := range got.Status.Conditions {
+		if condition.Type == "Ready" && condition.Status == "False" && condition.Reason == "ActorTemplateCreationFailed" {
+			return
+		}
+	}
+	t.Fatal("missing visible template failure condition")
+}
